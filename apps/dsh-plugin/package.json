{
  "name": "@maneki-pet/dsh-plugin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": "0.2.1-rc.5",
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@maneki-pet/adapter-dsh": "workspace:*",
    "@maneki-pet/core": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "vitest": "3.2.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
