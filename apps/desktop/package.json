{
  "name": "@maneki-pet/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-packs.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "pretest": "node scripts/generate-packs.mjs",
    "test": "node scripts/validate-packs.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "generate:packs": "node scripts/generate-packs.mjs",
    "generate:icons": "node scripts/generate-packs.mjs && tauri icon src-tauri/icons/icon-source.png",
    "tauri": "tauri"
  },
  "dependencies": {
    "@maneki-pet/core": "workspace:*",
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "vite": "^7.3.7"
  }
}
