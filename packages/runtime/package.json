{
  "name": "@maneki-pet/runtime",
  "version": "0.2.0-alpha.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/instance-lock/*.node"
  ],
  "scripts": {
    "build:native": "node scripts/build-instance-lock.mjs",
    "build": "pnpm build:native && tsc -p tsconfig.build.json",
    "pretest": "pnpm build:native",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@maneki-pet/adapter-dsh": "workspace:*",
    "@maneki-pet/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2"
  }
}
